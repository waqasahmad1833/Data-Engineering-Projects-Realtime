# Copy to .env (make init does this). Local demo values - change for anything shared.
COMPOSE_PROJECT_NAME=adtech

# ClickHouse application user (used by Flink, Grafana, scripts)
CH_PASSWORD=adtech_pwd

# MinIO (S3-compatible cold storage for ClickHouse + Flink checkpoints)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Load generator (events/second across all workers)
EVENTS_PER_SECOND=2000
GENERATOR_WORKERS=2
DUPLICATE_RATIO=0.01
INVALID_EVENT_RATIO=0.005
LATE_EVENT_RATIO=0.02

# Flink
FLINK_PARALLELISM=4
