      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT round(sum(spend_micros) / 1e6, 2) AS spend_usd FROM adtech.campaign_stats_1m WHERE $__timeFilter(minute)"
        }
      ],
      "fieldConfig": {
