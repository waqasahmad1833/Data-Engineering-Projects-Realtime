          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT round(sum(conversion_value_micros) / nullIf(sum(spend_micros), 0), 2) AS roas FROM adtech.campaign_stats_1m WHERE $__timeFilter(minute)"
