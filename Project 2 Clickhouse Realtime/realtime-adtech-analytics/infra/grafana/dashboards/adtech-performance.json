    {
      "id": 4,
      "type": "stat",
      "title": "ROAS",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
