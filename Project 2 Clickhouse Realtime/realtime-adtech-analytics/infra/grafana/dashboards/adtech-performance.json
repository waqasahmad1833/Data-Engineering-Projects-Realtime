    {
      "id": 5,
      "type": "timeseries",
      "title": "Events per minute",
      "description": "From the campaign_stats_1m materialized-view rollup.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT minute AS time, sum(bids) AS bid_events, sum(impressions) AS impression_events,\n       sum(clicks) AS click_events, sum(conversions) AS conversion_events\nFROM adtech.campaign_stats_1m\nWHERE $__timeFilter(minute)\nGROUP BY time\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Spend per minute by device",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT minute AS time, device_type, round(sum(spend_micros) / 1e6, 2) AS spend_usd\nFROM adtech.campaign_stats_1m\nWHERE $__timeFilter(minute)\nGROUP BY time, device_type\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Real-time spend (Flink 10 s windows)",
      "description": "Latest version of each window (late impressions re-fire windows).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT window_start AS time, round(sum(spend) / 1e6, 4) AS spend_usd_per_10s\nFROM (\n  SELECT campaign_id, window_start, argMax(spend_micros, version) AS spend\n  FROM adtech.campaign_spend_10s\n  WHERE $__timeFilter(window_start)\n  GROUP BY campaign_id, window_start\n)\nGROUP BY time\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Budget used today (top 10)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT dictGet('adtech.campaigns_dict', 'campaign_name', toUInt64(campaign_id)) AS campaign,\n       round(sum(spend) / dictGet('adtech.campaigns_dict', 'daily_budget_micros', toUInt64(campaign_id)) * 100, 3) AS budget_used_pct\nFROM (\n  SELECT campaign_id, window_start, argMax(spend_micros, version) AS spend\n  FROM adtech.campaign_spend_10s\n  WHERE window_start >= toStartOfDay(now())\n  GROUP BY campaign_id, window_start\n)\nGROUP BY campaign_id\nORDER BY budget_used_pct DESC\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [],
          "fields": "/budget_used_pct/",
          "values": true
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top campaigns",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT dictGet('adtech.campaigns_dict', 'campaign_name', toUInt64(campaign_id)) AS campaign,\n       sum(impressions) AS imps, sum(clicks) AS clks, sum(conversions) AS convs,\n       round(sum(spend_micros) / 1e6, 2) AS spend_usd,\n       round(clks / nullIf(imps, 0) * 100, 3) AS ctr_pct,\n       round(sum(conversion_value_micros) / nullIf(sum(spend_micros), 0), 2) AS roas,\n       uniqCombined64Merge(unique_users) AS reach\nFROM adtech.campaign_stats_1m\nWHERE $__timeFilter(minute)\nGROUP BY campaign_id\nORDER BY spend_usd DESC\nLIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Time to click (attributed)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT device_type, count() AS clicks_attributed,\n       round(quantile(0.5)(time_to_click_ms) / 1000, 1) AS p50_s,\n       round(quantile(0.9)(time_to_click_ms) / 1000, 1) AS p90_s,\n       round(quantile(0.99)(time_to_click_ms) / 1000, 1) AS p99_s\nFROM adtech.attributed_clicks\nWHERE $__timeFilter(click_time)\nGROUP BY device_type\nORDER BY clicks_attributed DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Dead letters",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT error_type, count() AS events, max(failed_at) AS last_seen\nFROM adtech.dead_letters\nWHERE $__timeFilter(failed_at)\nGROUP BY error_type\nORDER BY events DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "version": 1
}
