    {
      "id": 5,
      "type": "timeseries",
      "title": "Events per minute by type (Flink 1-min windows)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT window_start AS time, event_type, sum(event_count) AS events\nFROM analytics.page_metrics_1m FINAL\nWHERE $__timeFilter(window_start)\nGROUP BY time, event_type\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Conversion funnel (sessions)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH funnel AS (\n  SELECT session_id,\n    windowFunnel(3600)(toDateTime(event_time),\n      event_type = 'page_view', event_type = 'product_view', event_type = 'add_to_cart',\n      event_type = 'checkout_start', event_type = 'purchase') AS level\n  FROM analytics.events\n  WHERE $__timeFilter(event_time)\n  GROUP BY session_id\n)\nSELECT countIf(level >= 1) AS page_view, countIf(level >= 2) AS product_view,\n       countIf(level >= 3) AS add_to_cart, countIf(level >= 4) AS checkout_start,\n       countIf(level >= 5) AS purchase\nFROM funnel"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
