# ---------------------------------------------------------------------------
# Copy to .env (make init does this for you) and adjust as needed.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=clickstream

# ClickHouse credentials (used by ClickHouse, Flink sink, Grafana, smoke test)
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=analytics_pwd

# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Event simulator
EVENTS_PER_SECOND=50
NUM_USERS=2000
INVALID_EVENT_RATIO=0.02
LATE_EVENT_RATIO=0.05
MAX_LATE_SECONDS=120

# Flink
FLINK_PARALLELISM=2
